#!/bin/bash
# Lightweight native pre-commit checks.

set -euo pipefail

if [[ "${SKIP_HOOKS:-}" == "1" ]]; then
  echo "Skipping pre-commit hooks (SKIP_HOOKS=1)"
  exit 0
fi

STAGED_NATIVE_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(prosepal-ios/|docs/|scripts/|\.github/|AGENTS\.md|CLAUDE\.md|README\.md)' || true)"

if [[ -z "$STAGED_NATIVE_FILES" ]]; then
  echo "No native/docs/workflow files staged; skipping pre-commit checks."
  exit 0
fi

git diff --cached --check

JSONL_STAGED=0
CSV_STAGED=0
echo "$STAGED_NATIVE_FILES" | grep -q '^docs/reference/feature-status.jsonl$' && JSONL_STAGED=1
echo "$STAGED_NATIVE_FILES" | grep -q '^docs/reference/feature-status.csv$' && CSV_STAGED=1
if [[ "$JSONL_STAGED" != "$CSV_STAGED" ]]; then
  echo "Stage feature-status.jsonl and its generated CSV export together." >&2
  exit 1
fi

python3 scripts/validate_feature_status.py

if echo "$STAGED_NATIVE_FILES" | grep -q '^prosepal-ios/'; then
  (cd prosepal-ios && swift test --quiet)
fi

echo "Pre-commit checks passed."
