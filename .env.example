# ProsePal Native Environment Notes
#
# Copy this file to .env.local only for local notes. The native iOS app reads
# debug/runtime values from Xcode Run environment variables or local-only
# schemes. Do not commit .env.local, Xcode user schemes, secrets, receipts, or
# Supabase CLI link state.

# Staging gateway function URL, used in Xcode Run environment:
PROSEPAL_GATEWAY_URL=https://llolwgqphwnhbiqewmcq.supabase.co/functions/v1/generate-card

# Staging-only dev guard secret. Keep the real value in your shell/keychain or a
# local-only Xcode scheme; never print or commit it.
PROSEPAL_DEV_GATEWAY_SECRET=

# Supabase staging auth, used in Xcode Run environment:
PROSEPAL_SUPABASE_URL=https://llolwgqphwnhbiqewmcq.supabase.co
PROSEPAL_SUPABASE_ANON_KEY=

# StoreKit 2 product IDs for local/sandbox testing:
PROSEPAL_PREMIUM_PRODUCT_IDS=com.prosepal.pro.yearly,com.prosepal.pro.monthly,com.prosepal.pro.weekly
PROSEPAL_RECOMMENDED_PREMIUM_PRODUCT_ID=com.prosepal.pro.yearly
