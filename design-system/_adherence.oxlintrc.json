{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/ios/**",
              "components/product/**",
              "components/writing/**",
              "ui_kits/_shared/**",
              "ui_kits/prosepal-glass/**",
              "ui_kits/prosepal-minimalist/**",
              "ui_kits/prosepal-modern/**",
              "ui_kits/prosepal-notebook/**",
              "ui_kits/prosepal-studio/**",
              "ui_kits/prosepal/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono, Newsreader."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|className|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Avatar> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|icon|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|voice|info|warning|danger|outline)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'voice' | 'info' | 'warning' | 'danger' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|loading|icon|iconTrailing|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, loading, icon, iconTrailing, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|neutral|ghost|outline|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'neutral' | 'ghost' | 'outline' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|pad|interactive|as|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, pad, interactive, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|flat|raised|inset)$/]",
        "message": "<Card> variant must be one of 'default' | 'flat' | 'raised' | 'inset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:none|md|lg)$/]",
        "message": "<Card> pad must be one of 'none' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='DraftCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tones|voiceNote|variants|raised|actions|children|className|key|ref|className|style|children)$/]",
        "message": "<DraftCard> doesn't accept that prop. Declared props: label, tones, voiceNote, variants, raised, actions, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|action|className|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, body, action, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='GenerationState'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|lines|className|key|ref|className|style|children)$/]",
        "message": "<GenerationState> doesn't accept that prop. Declared props: label, lines, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|filled|accent)$/]",
        "message": "<IconButton> variant must be one of 'plain' | 'filled' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|title|subtitle|trailing|chevron|onClick|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: lead, title, subtitle, trailing, chevron, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|tone|thin|className|key|ref|className|style|children)$/]",
        "message": "<Meter> doesn't accept that prop. Declared props: value, max, tone, thin, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meter'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|voice|warning)$/]",
        "message": "<Meter> tone must be one of 'accent' | 'voice' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|largeTitle|leading|trailing|large|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: title, largeTitle, leading, trailing, large."
      },
      {
        "selector": "JSXOpeningElement[name.name='OnboardingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|eyebrow|title|body|actions|className|key|ref|className|style|children)$/]",
        "message": "<OnboardingCard> doesn't accept that prop. Declared props: icon, eyebrow, title, body, actions, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaywallFeature'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|sub|key|ref|className|style|children)$/]",
        "message": "<PaywallFeature> doesn't accept that prop. Declared props: icon, title, sub."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:screenBg|children|key|ref|className|style|children)$/]",
        "message": "<PhoneFrame> doesn't accept that prop. Declared props: screenBg, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='RefineAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<RefineAction> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|key|ref|className|style|children)$/]",
        "message": "<SegmentedItem> doesn't accept that prop. Declared props: value, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|className|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|fab|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: value, label, icon, fab."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToneChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|icon|ghost|children|key|ref|className|style|children)$/]",
        "message": "<ToneChip> doesn't accept that prop. Declared props: selected, icon, ghost, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToneOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<ToneOption> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrustNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|points|inline|className|key|ref|className|style|children)$/]",
        "message": "<TrustNote> doesn't accept that prop. Declared props: icon, title, body, points, inline, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='UsageCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:plan|used|total|unit|period|reset|action|className|key|ref|className|style|children)$/]",
        "message": "<UsageCard> doesn't accept that prop. Declared props: plan, used, total, unit, period, reset, action, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='WritingCanvas'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|prompt|count|tools|actions|focus|rows|className|key|ref|className|style|children)$/]",
        "message": "<WritingCanvas> doesn't accept that prop. Declared props: value, onChange, placeholder, prompt, count, tools, actions, focus, rows, className."
      }
    ]
  },
